{
  "name": "@babywbx/liveflow",
  "version": "1.2.0",
  "private": true,
  "description": "A browser-side live playback and realtime overlay stack.",
  "license": "MIT",
  "author": "Babywbx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babywbx/LiveFlow.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./continuity": {
      "types": "./dist/continuity/index.d.ts",
      "import": "./dist/continuity/index.js"
    },
    "./danmaku": {
      "types": "./dist/danmaku/index.d.ts",
      "import": "./dist/danmaku/index.js"
    },
    "./danmaku/dom": {
      "types": "./dist/danmaku/renderers/index.d.ts",
      "import": "./dist/danmaku/renderers/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js"
    },
    "./overlay/banner": {
      "types": "./dist/overlay/banner.d.ts",
      "import": "./dist/overlay/banner.js"
    },
    "./chrome": {
      "types": "./dist/chrome/index.d.ts",
      "import": "./dist/chrome/index.js"
    },
    "./multiview": {
      "types": "./dist/multiview/index.d.ts",
      "import": "./dist/multiview/index.js"
    },
    "./native-video": {
      "types": "./dist/adapters/native-video.d.ts",
      "import": "./dist/adapters/native-video.js"
    },
    "./page-activity": {
      "types": "./dist/adapters/document-page-activity.d.ts",
      "import": "./dist/adapters/document-page-activity.js"
    },
    "./artplayer": {
      "types": "./dist/adapters/artplayer.d.ts",
      "import": "./dist/adapters/artplayer.js"
    },
    "./dplayer": {
      "types": "./dist/adapters/dplayer.d.ts",
      "import": "./dist/adapters/dplayer.js"
    },
    "./videojs": {
      "types": "./dist/adapters/videojs.d.ts",
      "import": "./dist/adapters/videojs.js"
    },
    "./xgplayer": {
      "types": "./dist/adapters/xgplayer.d.ts",
      "import": "./dist/adapters/xgplayer.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint . --fix --deny-warnings --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "test:soak:browser": "BROWSER_SOAK_DURATION_MS=21600000 playwright test tests/browser/runtime-soak.spec.ts --project=chromium --workers=1",
    "examples:check": "pnpm --filter liveflow-examples build",
    "docs:check": "node scripts/check-doc-links.mjs",
    "size:check": "node scripts/check-bundle-size.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm docs:check && pnpm test && pnpm build && pnpm size:check && pnpm examples:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.16.0"
}
